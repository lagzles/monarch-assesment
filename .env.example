# REST API key used ONLY for the optional live verification step.
# Create it in Brevo: Account > SMTP & API > API keys.
# Accepted names: BREVO_API_KEY, brevo_key, BREVO_KEY.
BREVO_API_KEY=

# Optional: Brevo MCP token (JWT for https://mcp.brevo.com). Not used by this repo.
# brevo_server_mcp_key=

# Optional: override the spec location
# BREVO_OPENAPI_URL=https://api.brevo.com/v3/swagger_definition_v3.yml
